{
  "$schema": "../../schemas/product-config-v3.schema.json",
  "schemaVersion": 3,
  "product": {
    "code": "INVALID-OPERATION-PAIR",
    "version": "V1",
    "description": "纯测试产品不能声明 bundled 固件"
  },
  "lifecycle": {
    "status": "active"
  },
  "operation": {
    "mode": "test_only",
    "firmware": {
      "source": "bundled",
      "version": "1.0.0",
      "artifact": "INVALID-OPERATION-PAIR_V1.elf"
    }
  },
  "calibration": {
    "mode": "disabled",
    "reason": "本例只验证固件操作组合错误"
  },
  "protocol": "j1939",
  "bus": {
    "bitrateKbps": 250,
    "frameFormat": "extended",
    "sourceAddress": "0x33"
  },
  "messages": [
    {
      "id": "bjm",
      "name": "BJM1",
      "pgn": "0x00FDD6",
      "dlc": 8,
      "periodMs": 20
    }
  ],
  "signals": [
    {
      "id": "axisX",
      "kind": "position",
      "source": {
        "messageId": "bjm",
        "startByte": 0,
        "startBit": 6,
        "bitLength": 10,
        "endian": "little",
        "encoding": "unsigned"
      }
    }
  ],
  "controls": [
    {
      "id": "mainAxis",
      "type": "axis",
      "role": "joystick",
      "inputMode": "centered",
      "label": "主轴",
      "topology": {
        "kind": "singleAxis",
        "orientation": "horizontal"
      },
      "axis": {
        "signalId": "axisX",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
          "invert": false,
          "outputRange": [
            -1,
            1
          ]
        }
      }
    }
  ],
  "commands": [],
  "tests": [],
  "layout": {
    "mode": "designed",
    "canvas": {
      "width": 1280,
      "height": 720
    },
    "grid": {
      "rows": 1,
      "columns": 1
    },
    "cards": [
      {
        "id": "mainAxisCard",
        "kind": "controls",
        "title": "主轴",
        "grid": {
          "row": 0,
          "column": 0,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "contentCanvas": {
          "width": 580,
          "height": 300,
          "scaleMode": "uniform"
        },
        "elements": [
          {
            "id": "mainAxisElement",
            "controlId": "mainAxis",
            "renderer": "singleAxisGauge",
            "x": 0,
            "y": 0,
            "width": 580,
            "height": 300
          }
        ]
      }
    ]
  }
}
