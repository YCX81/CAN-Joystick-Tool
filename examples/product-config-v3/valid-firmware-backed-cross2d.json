{
  "$schema": "../../schemas/product-config-v3.schema.json",
  "schemaVersion": 3,
  "product": {
    "code": "JC6000-AR000003",
    "version": "V2.0.2",
    "description": "十字版，固件与产品版本同步"
  },
  "operation": {
    "mode": "firmware-backed",
    "firmware": {
      "source": "bundled",
      "version": "2.0.2",
      "artifact": "JC6000-AR000003_V2.0.2.elf"
    }
  },
  "protocol": "j1939",
  "bus": {
    "bitrateKbps": 250,
    "frameFormat": "extended",
    "sourceAddress": "0x33"
  },
  "messages": [
    {
      "id": "bjm",
      "name": "BJM1",
      "pgn": "0x00FDD6",
      "dlc": 8,
      "periodMs": 20
    }
  ],
  "signals": [
    {
      "id": "axisX",
      "kind": "position",
      "source": {
        "messageId": "bjm",
        "startByte": 0,
        "startBit": 6,
        "bitLength": 10,
        "endian": "little",
        "encoding": "unsigned"
      }
    },
    {
      "id": "axisY",
      "kind": "position",
      "source": {
        "messageId": "bjm",
        "startByte": 2,
        "startBit": 6,
        "bitLength": 10,
        "endian": "little",
        "encoding": "unsigned"
      }
    }
  ],
  "controls": [
    {
      "id": "joystickXY",
      "type": "joystick",
      "label": "十字手柄",
      "topology": {
        "kind": "cross2D",
        "gate": "cross"
      },
      "xAxis": {
        "signalId": "axisX",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
          "invert": false,
          "outputRange": [
            -1,
            1
          ]
        }
      },
      "yAxis": {
        "signalId": "axisY",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
          "invert": true,
          "outputRange": [
            -1,
            1
          ]
        }
      }
    }
  ],
  "commands": [],
  "tests": [],
  "layout": {
    "mode": "designed",
    "canvas": {
      "width": 1280,
      "height": 720
    },
    "cards": [
      {
        "id": "joystickCard",
        "title": "十字手柄",
        "x": 24,
        "y": 24,
        "width": 580,
        "height": 580,
        "renderer": "joystickPad",
        "controlIds": [
          "joystickXY"
        ]
      }
    ]
  }
}
