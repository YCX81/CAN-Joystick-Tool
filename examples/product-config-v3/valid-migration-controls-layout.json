{
  "$schema": "../../schemas/product-config-v3.schema.json",
  "schemaVersion": 3,
  "product": {
    "code": "V3-CONTROL-COVERAGE",
    "version": "V1",
    "description": "批量迁移所需控件和系统卡片覆盖样例"
  },
  "lifecycle": {
    "status": "active"
  },
  "operation": {
    "mode": "test_only",
    "firmware": {
      "source": "external"
    }
  },
  "calibration": {
    "mode": "minCenterMax",
    "transport": "j1939VendorPgn",
    "allowedInNormalModeReadOnly": true
  },
  "protocol": "j1939",
  "bus": {
    "bitrateKbps": 250,
    "frameFormat": "extended",
    "sourceAddress": "0x33"
  },
  "messages": [
    {
      "id": "controls",
      "name": "迁移控件报文",
      "pgn": "0x00FDD7",
      "dlc": 8,
      "periodMs": 20
    }
  ],
  "signals": [
    {
      "id": "rollerPosition",
      "kind": "position",
      "source": {
        "messageId": "controls",
        "startByte": 0,
        "startBit": 0,
        "bitLength": 16,
        "endian": "little",
        "encoding": "unsigned"
      }
    },
    {
      "id": "potentiometerPosition",
      "kind": "position",
      "source": {
        "messageId": "controls",
        "startByte": 2,
        "startBit": 0,
        "bitLength": 16,
        "endian": "little",
        "encoding": "unsigned"
      }
    },
    {
      "id": "buttonStates",
      "kind": "packedButtons",
      "source": {
        "messageId": "controls",
        "startByte": 4,
        "startBit": 0,
        "bitLength": 10,
        "endian": "little",
        "encoding": "j1939_2bit"
      }
    },
    {
      "id": "displayValue",
      "kind": "numeric",
      "source": {
        "messageId": "controls",
        "startByte": 6,
        "startBit": 0,
        "bitLength": 8,
        "endian": "little",
        "encoding": "unsigned"
      }
    },
    {
      "id": "statusValue",
      "kind": "status",
      "source": {
        "messageId": "controls",
        "startByte": 7,
        "startBit": 0,
        "bitLength": 2,
        "endian": "little",
        "encoding": "unsigned"
      }
    }
  ],
  "controls": [
    {
      "id": "rollerAxis",
      "type": "axis",
      "role": "roller",
      "inputMode": "centered",
      "zeroAsNeutral": true,
      "label": "滚轮",
      "topology": {
        "kind": "singleAxis",
        "orientation": "vertical"
      },
      "axis": {
        "signalId": "rollerPosition",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
          "invert": false,
          "outputRange": [
            -1,
            1
          ]
        }
      }
    },
    {
      "id": "potentiometerAxis",
      "type": "axis",
      "role": "potentiometer",
      "inputMode": "unipolar",
      "label": "电位器",
      "display": {
        "valueMin": 0,
        "valueMax": 100,
        "angleMinDegrees": -135,
        "angleMaxDegrees": 135,
        "unit": "%"
      },
      "topology": {
        "kind": "singleAxis",
        "orientation": "horizontal"
      },
      "axis": {
        "signalId": "potentiometerPosition",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 0,
          "invert": false,
          "outputRange": [
            -1,
            1
          ]
        }
      }
    },
    {
      "id": "physicalButton",
      "type": "button",
      "label": "实体按钮 1",
      "signalId": "buttonStates",
      "position": 0
    },
    {
      "id": "direction",
      "type": "fnr",
      "label": "FNR",
      "signalId": "buttonStates",
      "positions": {
        "neutralMode": "inferred",
        "forward": 2,
        "reverse": 4
      }
    },
    {
      "id": "valueDisplay",
      "type": "numericDisplay",
      "label": "数值",
      "signalId": "displayValue",
      "format": {
        "decimals": 0,
        "unit": "%"
      }
    },
    {
      "id": "statusIndicator",
      "type": "indicator",
      "label": "状态",
      "signalId": "statusValue",
      "states": [
        {
          "value": 0,
          "label": "空闲",
          "color": "#808080"
        },
        {
          "value": 1,
          "label": "有效",
          "color": "#00A651"
        },
        {
          "value": 2,
          "label": "故障",
          "color": "#D32F2F"
        }
      ]
    }
  ],
  "commands": [],
  "tests": [],
  "layout": {
    "mode": "designed",
    "canvas": {
      "width": 1600,
      "height": 900
    },
    "grid": {
      "rows": 4,
      "columns": 3
    },
    "cards": [
      {
        "id": "joystickLeftRegion",
        "kind": "leftRegion",
        "title": "左侧主控区",
        "grid": {
          "row": 0,
          "column": 0,
          "rowSpan": 4,
          "columnSpan": 1
        },
        "controlId": "rollerAxis",
        "widthRatio": 0.52
      },
      {
        "id": "controlCard",
        "kind": "controls",
        "title": "产品控件",
        "grid": {
          "row": 0,
          "column": 1,
          "rowSpan": 2,
          "columnSpan": 1
        },
        "contentCanvas": {
          "width": 1000,
          "height": 900,
          "scaleMode": "uniform"
        },
        "elements": [
          {
            "id": "rollerElement",
            "controlId": "rollerAxis",
            "renderer": "roller",
            "x": 20,
            "y": 20,
            "width": 280,
            "height": 280,
            "properties": {
              "orientation": "vertical",
              "showLabel": true,
              "showValue": true
            }
          },
          {
            "id": "potentiometerElement",
            "controlId": "potentiometerAxis",
            "renderer": "potentiometer",
            "x": 320,
            "y": 20,
            "width": 280,
            "height": 280,
            "properties": {
              "orientation": "horizontal",
              "showLabel": true,
              "showValue": true
            }
          },
          {
            "id": "buttonElement",
            "controlId": "physicalButton",
            "renderer": "button",
            "x": 620,
            "y": 20,
            "width": 150,
            "height": 120,
            "properties": {
              "showLabel": true,
              "compact": true
            }
          },
          {
            "id": "fnrElement",
            "controlId": "direction",
            "renderer": "fnr",
            "x": 790,
            "y": 20,
            "width": 170,
            "height": 280,
            "properties": {
              "orientation": "horizontal",
              "showLabel": true,
              "compact": false
            }
          },
          {
            "id": "numericElement",
            "controlId": "valueDisplay",
            "renderer": "numericDisplay",
            "x": 20,
            "y": 330,
            "width": 280,
            "height": 180,
            "properties": {
              "showLabel": true,
              "showValue": true,
              "decimals": 0,
              "unit": "%"
            }
          },
          {
            "id": "indicatorElement",
            "controlId": "statusIndicator",
            "renderer": "indicator",
            "x": 320,
            "y": 330,
            "width": 280,
            "height": 180,
            "properties": {
              "showLabel": true,
              "compact": true
            }
          }
        ]
      },
      {
        "id": "blankCanvasCard",
        "kind": "controls",
        "title": "保留空白画布",
        "grid": {
          "row": 2,
          "column": 1,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "contentCanvas": {
          "width": 480,
          "height": 480,
          "scaleMode": "uniform"
        },
        "elements": []
      },
      {
        "id": "explicitEmptyCard",
        "kind": "empty",
        "title": "",
        "grid": {
          "row": 3,
          "column": 1,
          "rowSpan": 1,
          "columnSpan": 1
        }
      },
      {
        "id": "busStatsCard",
        "kind": "system",
        "title": "总线统计",
        "grid": {
          "row": 0,
          "column": 2,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "systemType": "busStats",
        "properties": {
          "refreshMs": 500,
          "showChannel": true
        }
      },
      {
        "id": "rawFramesCard",
        "kind": "system",
        "title": "原始报文",
        "grid": {
          "row": 1,
          "column": 2,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "systemType": "rawFrames",
        "properties": {
          "maxRows": 200,
          "showTimestamp": true,
          "showChannel": true,
          "showDirection": true
        }
      },
      {
        "id": "recordInfoCard",
        "kind": "system",
        "title": "记录信息",
        "grid": {
          "row": 2,
          "column": 2,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "systemType": "recordInfo",
        "properties": {
          "showOperator": true,
          "showSerialNumber": true
        }
      }
    ]
  }
}
