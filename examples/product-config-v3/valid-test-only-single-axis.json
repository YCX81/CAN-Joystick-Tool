{
  "$schema": "../../schemas/product-config-v3.schema.json",
  "schemaVersion": 3,
  "product": {
    "code": "JC6000-BGA-C0009",
    "version": "V1",
    "description": "无固件单轴纯测试产品"
  },
  "operation": {
    "mode": "test_only",
    "firmware": {
      "source": "external"
    }
  },
  "protocol": "j1939",
  "bus": {
    "bitrateKbps": 250,
    "frameFormat": "extended",
    "sourceAddress": "0x33"
