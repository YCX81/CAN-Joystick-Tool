        "encoding": "unsigned"
      }
    },
    {
      "id": "button1",
      "kind": "button",
      "source": {
        "messageId": "bjm",
        "startByte": 5,
        "startBit": 0,
        "bitLength": 2,
        "endian": "little",
        "encoding": "j1939_2bit"
      }
    }
  ],
  "controls": [
    {
      "id": "mainAxis",
      "type": "axis",
      "label": "主轴",
      "topology": {
        "kind": "singleAxis",
        "orientation": "horizontal"
      },
      "axis": {
        "signalId": "axisX",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
