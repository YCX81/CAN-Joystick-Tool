        "x": 24,
        "y": 24,
        "width": 580,
        "height": 300,
        "renderer": "singleAxisGauge",
        "controlIds": [
          "mainAxis"
        ]
      },
      {
        "id": "buttonsCard",
        "title": "按钮",
        "x": 628,
        "y": 24,
        "width": 300,
        "height": 300,
