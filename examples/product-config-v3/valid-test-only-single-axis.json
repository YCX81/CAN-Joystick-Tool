{
  "$schema": "../../schemas/product-config-v3.schema.json",
  "schemaVersion": 3,
  "product": {
    "code": "JC6000-BGA-C0009",
    "version": "V1",
    "description": "无固件单轴纯测试产品"
  },
  "lifecycle": {
    "status": "active"
  },
  "operation": {
    "mode": "test_only",
    "firmware": {
      "source": "external"
    }
  },
  "calibration": {
    "mode": "disabled",
    "reason": "该纯测试产品没有校准指令"
  },
  "protocol": "j1939",
  "bus": {
    "bitrateKbps": 250,
    "frameFormat": "extended",
    "sourceAddress": "0x33"
  },
  "messages": [
    {
      "id": "bjm",
      "name": "BJM1",
      "pgn": "0x00FDD6",
      "dlc": 8,
      "periodMs": 20
    }
  ],
  "signals": [
    {
      "id": "axisX",
      "kind": "position",
      "source": {
        "messageId": "bjm",
        "startByte": 0,
        "startBit": 6,
        "bitLength": 10,
        "endian": "little",
        "encoding": "unsigned"
      }
    },
    {
      "id": "button1",
      "kind": "packedButtons",
      "source": {
        "messageId": "bjm",
        "startByte": 5,
        "startBit": 0,
        "bitLength": 2,
        "endian": "little",
        "encoding": "j1939_2bit",
        "buttonBitPositions": [
          0
        ]
      }
    }
  ],
  "controls": [
    {
      "id": "mainAxis",
      "type": "axis",
      "role": "joystick",
      "inputMode": "centered",
      "label": "主轴",
      "topology": {
        "kind": "singleAxis",
        "orientation": "horizontal"
      },
      "axis": {
        "signalId": "axisX",
        "transform": {
          "rawMin": 0,
          "rawCenter": 500,
          "rawMax": 1000,
          "deadzone": 20,
          "invert": false,
          "outputRange": [
            -1,
            1
          ]
        }
      }
    },
    {
      "id": "button1",
      "type": "button",
      "label": "按钮 1",
      "signalId": "button1",
      "position": 0
    }
  ],
  "commands": [],
  "tests": [],
  "layout": {
    "mode": "designed",
    "canvas": {
      "width": 1280,
      "height": 720
    },
    "grid": {
      "rows": 1,
      "columns": 2
    },
    "cards": [
      {
        "id": "mainAxisCard",
        "kind": "controls",
        "title": "主轴",
        "grid": {
          "row": 0,
          "column": 0,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "contentCanvas": {
          "width": 580,
          "height": 300,
          "scaleMode": "uniform"
        },
        "elements": [
          {
            "id": "mainAxisElement",
            "controlId": "mainAxis",
            "renderer": "singleAxisGauge",
            "x": 0,
            "y": 0,
            "width": 580,
            "height": 300
          }
        ]
      },
      {
        "id": "buttonsCard",
        "kind": "controls",
        "title": "按钮",
        "grid": {
          "row": 0,
          "column": 1,
          "rowSpan": 1,
          "columnSpan": 1
        },
        "contentCanvas": {
          "width": 300,
          "height": 300,
          "scaleMode": "uniform"
        },
        "elements": [
          {
            "id": "button1Element",
            "controlId": "button1",
            "renderer": "button",
            "x": 0,
            "y": 0,
            "width": 300,
            "height": 300
          }
        ]
      }
    ]
  }
}
